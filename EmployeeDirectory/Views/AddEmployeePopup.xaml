<views:MvxWindow
    x:TypeArguments="viewModels:AddEmployeeViewModel"
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:viewModels="clr-namespace:EmployeeDirectory.Core.ViewModels;assembly=EmployeeDirectory.Core"
    x:Class="EmployeeDirectory.WPF.Views.AddEmployeePopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="350" Width="400" Height="450">
    
     <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
         
        <Style TargetType="Button" x:Key="SaveButtonStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style BasedOn="{StaticResource SaveButtonStyle}" TargetType="Button" x:Key="CancelButtonStyle">
            <Setter Property="BorderBrush" Value="Red" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Red" />
        </Style>
    </Window.Resources>
    
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Add New Employee" FontWeight="Bold" Margin="0,0,0,10" />
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock>
                    <Run Text="Name" />
                    <Run Text="*" Foreground="Red"/>
                </TextBlock>
                <TextBox x:Name="NameTextBox" Margin="0,5" Text="{Binding NewEmployeeName}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock>
                    <Run Text="Email" />
                    <Run Text="*" Foreground="Red"/>
                </TextBlock>
                <TextBox x:Name="EmailTextBox" Margin="0,5" Text="{Binding NewEmployeeEmail}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Position" />
                <TextBox x:Name="PositionTextBox" Margin="0,5" Text="{Binding NewEmployeePosition}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Department" />
                <TextBox x:Name="DepartmentTextBox" Margin="0,5" Text="{Binding NewEmployeeDepartment}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">

                <Button Content="Submit" Style="{StaticResource SaveButtonStyle}" Command="{Binding SubmitEmployeeCommand}" Margin="5" Padding="5"/>
                <Button Content="Cancel" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="5" Padding="5"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</views:MvxWindow>



